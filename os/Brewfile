# Homebrew Bundle - All packages and apps
# tap "nikitabobko/tap"

# Core CLI Tools
brew "bash"            # Bash 5+ (required by tmux-powerkit plugin)
brew "zsh"
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Development Tools
brew "vim"              # macOS's system vim lacks +clipboard; needed for `set clipboard=unnamed`
brew "tmux"
brew "fzf"
brew "ripgrep"
brew "bat"              # Syntax-highlighted previews for fzf.vim
brew "gh"              # GitHub CLI
brew "node"             # Runs coc.nvim (vim/plugins/coc.vim)
brew "nvm"
brew "watchman"            # Required by rubocop and sorbet for file watching
brew "lazygit"

# Navigation
brew "fd"               # Backs `fcd` (zsh/functions/fzf-pickers.zsh) and yazi's file search

# Terminal Enhancement
brew "starship"        # Prompt
brew "coreutils"       # GNU core utils (grealpath for yazi)
brew "yazi"             # Terminal file manager (zsh `y` function, tmux-yazi.sh)

# GUI Applications
cask "ghostty"
cask "google-chrome"
cask "monitorcontrol"
cask "obsidian"
cask "voiceink"

cask "nikitabobko/tap/aerospace"

cask "font-psudofont-liga-mono"
