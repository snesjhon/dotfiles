# Based on josean's dotfiles: https://github.com/josean-dev/dev-environment-files/blob/main/.zshrc
# ============================================================
# Main entry point. Layout mirrors vim/ (vimrc -> plugins.vim/mappings.vim):
#   zshrc           - this file: core shell options only
#   plugins.zsh     - plugin loading + bootstrap
#   mappings.zsh    - all keybindings, plugin or not
#   plugins/*.zsh   - one file per plugin's own settings/functions
#                     (no keybindings -- those belong in mappings.zsh)
#   functions/*.zsh - general-purpose custom functions
# ============================================================

export EDITOR=vim
export VISUAL=vim

HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify
setopt NO_BEEP
setopt IGNORE_EOF

source "$ZSH_CONFIG_DIR/plugins.zsh"
source "$ZSH_CONFIG_DIR/mappings.zsh"

autoload -Uz compinit
compinit

source "$ZSH_CONFIG_DIR/zaliases"

# Source custom functions
for file in $ZSH_CONFIG_DIR/functions/*.zsh; do
  source "$file"
done

export PATH="$HOME/.local/bin:$PATH"

# Machine/company-specific overrides (gitignored)
[[ -f "$ZSH_CONFIG_DIR/zshrc.local" ]] && source "$ZSH_CONFIG_DIR/zshrc.local"
