export EDITOR=vim
export VISUAL=vim

HISTFILE=$HOME/.zhistory
SAVEHIST=1000
HISTSIZE=999

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify
setopt NO_BEEP
setopt IGNORE_EOF

# Disable XON/XOFF flow control -- otherwise the tty driver eats Ctrl-S/Ctrl-Q itself
# (pause/resume output) before apps like vim ever see them, and a stray Ctrl-S silently
# freezes all terminal output until Ctrl-Q is pressed, which looks like random lag.
# stty -ixon

source "$ZSH_CONFIG_DIR/plugins.zsh"
source "$ZSH_CONFIG_DIR/mappings.zsh"

autoload -Uz compinit
compinit

source "$ZSH_CONFIG_DIR/zaliases"

# Source custom functions
for file in $ZSH_CONFIG_DIR/functions/*.zsh; do
  source "$file"
done

export PATH="$HOME/.local/bin:$PATH"

# Machine/company-specific overrides (gitignored)
[[ -f "$ZSH_CONFIG_DIR/zshrc.local" ]] && source "$ZSH_CONFIG_DIR/zshrc.local"
