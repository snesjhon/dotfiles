export EDITOR=nvim
export VISUAL=nvim

# Base-branch resolution shared by nvim's :Review and the gitsigns PR-base toggle, so they treat "the PR" identically.
export GIT_PR_BASE_SCRIPT="${ZSH_CONFIG_DIR:h}/scripts/git-pr-base.sh"

HISTFILE=$HOME/.zhistory
SAVEHIST=100
HISTSIZE=100

setopt share_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_verify
setopt NO_BEEP
setopt IGNORE_EOF

# Blank the prompt EOL mark (zsh defaults it to a bold inverse "%"). PROMPT_SP
# sizes its padding to the terminal width, so a terminal that changes width
# (an nvim split opening or closing, say) can strand that mark partway up the
# window. Empty keeps the partial-line preservation, minus the visible marker.
PROMPT_EOL_MARK=''

source "$ZSH_CONFIG_DIR/plugins.zsh"
source "$ZSH_CONFIG_DIR/mappings.zsh"

# Completions shipped with the dotfiles' plugins (plugins/*/zsh).
fpath=(${ZSH_CONFIG_DIR:h}/plugins/*/zsh(N) $fpath)
autoload -Uz compinit
compinit

source "$ZSH_CONFIG_DIR/zaliases"

# Source custom functions
for file in $ZSH_CONFIG_DIR/functions/*.zsh; do
  source "$file"
done

export PATH="$HOME/.local/bin:$PATH"

# Machine/company-specific overrides (gitignored)
[[ -f "$ZSH_CONFIG_DIR/zshrc.local" ]] && source "$ZSH_CONFIG_DIR/zshrc.local"
