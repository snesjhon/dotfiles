# .zshenv - sourced for all zsh invocations (login, interactive, scripts)
# This ensures PATH is set correctly even in tmux and other non-interactive contexts

# ZSH config directory - resolve symlink to get dotfiles location
ZSH_CONFIG_DIR="$HOME/.zshenv"
export ZSH_CONFIG_DIR="${ZSH_CONFIG_DIR:A:h}"

# HOMEBREW
# Guarded on HOMEBREW_PREFIX so child zsh -c invocations (fzf reload/transform/become) skip re-forking brew -- measured ~40-50ms per invocation otherwise.
[[ -z "$HOMEBREW_PREFIX" && -x /opt/homebrew/bin/brew ]] && eval "$(/opt/homebrew/bin/brew shellenv)"
